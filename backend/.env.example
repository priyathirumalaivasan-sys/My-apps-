# Vasan AI Studio Backend Environment Variables
# Copy this file to .env and fill in the API keys for the providers you want to enable.
# NEVER commit .env to version control or expose these keys in the Android APK.

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Firebase Admin Project ID (for verifying Android client Firebase ID tokens)
FIREBASE_PROJECT_ID=gen-lang-client-0693753268

# 1. Kling AI (https://klingai.com/dev)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# 2. MiniMax Hailuo AI (https://platform.minimaxi.com)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 3. Google Veo (Gemini API / Vertex AI Veo)
GOOGLE_VEO_API_KEY=

# 4. Runway AI (https://docs.dev.runwayml.com)
RUNWAY_API_KEY=
